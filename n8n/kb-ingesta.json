{"name":"Ingesta KB","nodes":[{"parameters":{"rule":{"interval":[{"field":"minutes","minutesInterval":1}]}},"id":"k1","name":"Cada 5 min","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.2,"position":[-400,300]},{"parameters":{"operation":"executeQuery","query":"select id, doc_id, base_id, pdf_url from documentos_kb where estado='procesando' and pdf_url is not null and pdf_url<>'' order by creado_en limit 1;","options":{}},"id":"k2","name":"Doc pendiente","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[-220,300],"credentials":{"postgres":{"id":"POSTGRES_CRED_ID","name":"Postgres del motor"}}},{"parameters":{"url":"={{ $json.pdf_url }}","options":{"response":{"response":{"responseFormat":"file","outputPropertyName":"data"}}}},"id":"k3","name":"Descargar PDF","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[-40,300]},{"parameters":{"operation":"pdf","binaryPropertyName":"data","options":{}},"id":"k4","name":"PDF a texto","type":"n8n-nodes-base.extractFromFile","typeVersion":1,"position":[140,300]},{"parameters":{"operation":"executeQuery","query":"delete from kb_embeddings where doc_id = '{{ $('Doc pendiente').first().json.doc_id }}';","options":{}},"id":"k5","name":"Borrar vectores viejos","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[320,300],"credentials":{"postgres":{"id":"POSTGRES_CRED_ID","name":"Postgres del motor"}}},{"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"const texto = ($('PDF a texto').first().json.text) || '';\nconst d = $('Doc pendiente').first().json;\nconst limpio = texto.replace(/\\s+/g,' ').trim();\nconst size = 900; const chunks = [];\nfor (let i=0;i<limpio.length;i+=size) chunks.push(limpio.slice(i,i+size));\nreturn chunks.filter(c=>c.length>5).map((c,idx)=>({ json: { contenido: c, doc_id: d.doc_id, base_id: d.base_id, idx } }));"},"id":"k6","name":"Chunkear","type":"n8n-nodes-base.code","typeVersion":2,"position":[500,300]},{"parameters":{"method":"POST","url":"https://api.openai.com/v1/embeddings","authentication":"predefinedCredentialType","nodeCredentialType":"openAiApi","sendBody":true,"specifyBody":"json","jsonBody":"={{ JSON.stringify({ model: 'text-embedding-3-small', input: $json.contenido }) }}","options":{}},"id":"k7","name":"Embeddings","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[680,300],"credentials":{"openAiApi":{"id":"OPENAI_CRED_ID","name":"OpenAi account"}}},{"parameters":{"mode":"runOnceForEachItem","language":"javaScript","jsCode":"const emb = $json.data[0].embedding;\nconst ch = $('Chunkear').item.json;\nconst c = (ch.contenido||'').replace(/'/g, \"''\");\nconst vec = '[' + emb.join(',') + ']';\nconst meta = JSON.stringify({ doc_id: ch.doc_id }).replace(/'/g, \"''\");\nconst sql = `insert into kb_embeddings (base_id, doc_id, contenido, embedding, metadata) values ('${ch.base_id}','${ch.doc_id}','${c}','${vec}'::vector,'${meta}'::jsonb)`;\nreturn { json: { sql } };"},"id":"k8","name":"Armar insert","type":"n8n-nodes-base.code","typeVersion":2,"position":[860,300]},{"parameters":{"operation":"executeQuery","query":"={{ $json.sql }}","options":{}},"id":"k9","name":"Upsert vector","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[1040,300],"credentials":{"postgres":{"id":"POSTGRES_CRED_ID","name":"Postgres del motor"}}},{"parameters":{"operation":"executeQuery","query":"update documentos_kb set estado='listo' where doc_id = '{{ $('Doc pendiente').first().json.doc_id }}';","options":{}},"id":"k10","name":"Marcar listo","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[1220,300],"credentials":{"postgres":{"id":"POSTGRES_CRED_ID","name":"Postgres del motor"}}}],"connections":{"Cada 5 min":{"main":[[{"node":"Doc pendiente","type":"main","index":0}]]},"Doc pendiente":{"main":[[{"node":"Descargar PDF","type":"main","index":0}]]},"Descargar PDF":{"main":[[{"node":"PDF a texto","type":"main","index":0}]]},"PDF a texto":{"main":[[{"node":"Borrar vectores viejos","type":"main","index":0}]]},"Borrar vectores viejos":{"main":[[{"node":"Chunkear","type":"main","index":0}]]},"Chunkear":{"main":[[{"node":"Embeddings","type":"main","index":0}]]},"Embeddings":{"main":[[{"node":"Armar insert","type":"main","index":0}]]},"Armar insert":{"main":[[{"node":"Upsert vector","type":"main","index":0}]]},"Upsert vector":{"main":[[{"node":"Marcar listo","type":"main","index":0}]]}},"settings":{"executionOrder":"v1"}}