# Postgres del motor (el mismo que levanta docker-compose)
DATABASE_URL=postgres://nods:cambiar_esto@localhost:5433/agentes

# Webhook de n8n que dispara el motor desde el frontend (botón ▶ Preview).
#  - Para iterar rápido sin activar: usá /webhook-test/  (dispara 1 vez por click en "Test workflow")
#  - Para usar el preview repetidamente: ACTIVÁ el workflow y dejá /webhook/ (URL de producción)
N8N_PREVIEW_URL=

# Base de la instancia de n8n (sin barra final). La usan los endpoints de Insights
# (/webhook/insights-ia) y el Juez QA (/webhook/juez-qa-run).
#   local: http://localhost:5678
N8N_BASE_URL=

# ── Storage de archivos de la KB (servicio storage/) ────────────────────────
# URL del servicio de storage y su token de subida (debe coincidir con UPLOAD_TOKEN
# del servicio storage/).
STORAGE_URL=
STORAGE_TOKEN=

# ── Pre-seed machine-to-machine (CRMs externos → /api/preseed) ──────────────
# Secreto que se exige en el header x-preseed-secret. Generá uno con:
#   openssl rand -hex 24
PRESEED_SECRET=

# ── Autenticación (Auth.js / Google OAuth) ──────────────────────────────────
# Secreto para firmar las sesiones. Generá uno con: openssl rand -base64 33
AUTH_SECRET=

# Credenciales del cliente OAuth de Google (Google Cloud Console → Credentials).
# Authorized redirect URI a cargar en Google:
#   https://TU-DOMINIO/api/auth/callback/google
#   (local: http://localhost:3000/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# En producción, la URL pública del panel (para los callbacks de OAuth).
# AUTH_URL=https://panel-production-6232.up.railway.app

# ── Allowlist de acceso (OBLIGATORIO — fail-closed: vacío = nadie entra) ─────
# Dominio de la empresa permitido (sin @):
ALLOWED_EMAIL_DOMAIN=gruponods.com
# Opcional: mails sueltos extra, separados por coma
# ALLOWED_EMAILS=externo@gmail.com
