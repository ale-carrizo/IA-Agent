# Copialo a .env (o cargá estas variables en Railway).

# ── Base ────────────────────────────────────────────────────────────────────
# LA MISMA base del motor de agentes y del panel. El servicio no tiene base
# propia: Postgres es la única fuente de verdad, y ahí viven también los
# checkpoints de LangGraph.
DATABASE_URL=postgres://iaagent:cambiar_esto@localhost:5433/agentes

# ── Transporte (n8n) ────────────────────────────────────────────────────────
# El servicio NUNCA habla con un canal directo. Postea acá y el workflow
# "Licitaciones - Salida" resuelve Botmaker / Kapso / WhatsApp Cloud.
N8N_SALIDA_URL=http://localhost:5678/webhook/licitaciones-salida
# Token compartido: se exige en el header x-token de los endpoints del servicio
# y se manda en el header x-token hacia n8n. Generá uno con: openssl rand -hex 24
N8N_TOKEN=

# ── LLM ─────────────────────────────────────────────────────────────────────
# openai       → interpretar/expresar con modelos reales
# determinista → sin red: heurísticas + plantillas (CI, tests, fallback)
LLM_MODO=openai
OPENAI_API_KEY=
# Barato: sólo traduce texto → estructura.
MODELO_INTERPRETAR=gpt-4o-mini
# El principal: redacta con el tono del agente.
MODELO_EXPRESAR=gpt-4o
# Misma dimensión (1536) que kb_embeddings del motor.
MODELO_EMBEDDINGS=text-embedding-3-small

# Agente del motor del que se toman tono y guardrails ("la conducta es data").
# Vacío = defaults del código.
AGENTE_LICITACIONES_ID=

# ── Supervisor ──────────────────────────────────────────────────────────────
MINUTOS_SIN_RESPUESTA=45
MAX_RECORDATORIOS=2
HORAS_ESCALACION_VOZ=3

# ── El sobre por defecto (precio histórico × factor) ────────────────────────
# El humano lo pisa por ítem desde el panel.
FACTOR_PRECIO_MAX=1.15
FACTOR_PRECIO_OBJETIVO=0.98

# ── Auditoría ───────────────────────────────────────────────────────────────
# Desvío contra el histórico a partir del cual se marca "verificar outlier".
DESVIO_OUTLIER=0.30

LOG_LEVEL=INFO
